FROM node:20-alpine AS builder
WORKDIR /app
COPY dlmm-user-ui/package.json dlmm-user-ui/package-lock.json* ./
RUN npm ci --prefer-offline
COPY dlmm-user-ui/ ./
RUN npm run build

FROM nginx:1.25-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY dlmm-user-ui/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
