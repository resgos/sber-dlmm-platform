# Sber DLMM Admin UI — environment variables
# Copy to `.env.local` (git-ignored by Vite by default) and edit.

# Set to "true" to bypass the real backend and use src/api/mockApi.ts.
# Useful for offline UI work or running the admin UI without the Spring stack.
# Default (unset/false): UI calls the real gateway via the Vite /api proxy.
VITE_USE_MOCKS=false
