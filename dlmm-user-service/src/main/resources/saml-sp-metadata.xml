<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sber DLMM Platform - SAML 2.0 SP Metadata (placeholder)

  This is a placeholder SP metadata document. In production:
  1. Add spring-security-saml2-service-provider to pom.xml
  2. Configure RelyingPartyRegistration with your IdP metadata URL
  3. Spring Security SAML2 will generate correct SP metadata automatically

  See docs/SAML-INTEGRATION-GUIDE.md for Azure AD and Sber Federation setup.

  Entity ID and ACS URL must match the values registered in your IdP:
    - Azure AD: App registration > SAML SSO configuration
    - Sber Federation: SP registration form (contact dlmm-infra@sber.ru)
-->
<md:EntityDescriptor
    xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata"
    entityID="https://dlmm.sber-online.ru/saml/sp">

  <md:SPSSODescriptor
      AuthnRequestsSigned="false"
      WantAssertionsSigned="true"
      protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">

    <!--
      Assertion Consumer Service: IdP will POST the SAML assertion here
      after successful authentication. Must be HTTPS in production.
    -->
    <md:AssertionConsumerService
        Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
        Location="https://dlmm.sber-online.ru/api/v1/auth/saml/callback"
        index="1"/>

  </md:SPSSODescriptor>

</md:EntityDescriptor>
