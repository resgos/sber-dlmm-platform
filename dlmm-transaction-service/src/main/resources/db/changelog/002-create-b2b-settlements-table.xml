<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
        Sprint 4 #4.6 — B2B settlement audit trail.

        A B2B settlement is a corp-to-corp transfer (e.g. Sber Treasury →
        MOEX clearing) routed through DLMM token rails. Same-token transfer
        only for the prototype; FX-conversion settlement is a pool swap
        and lives in the existing transactions table.

        Unique index on `reference` is the idempotency anchor — the corp
        ERP (1С / SAP) generates a deterministic ref per settlement and
        the second call with the same ref returns the existing row.

        preConditions wrap honours the same convention as 001 — coexists
        with init-db.sql in environments where the table was bootstrapped
        outside Liquibase.
    -->
    <changeSet id="002-create-b2b-settlements-table" author="dlmm-platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="b2b_settlements"/></not>
        </preConditions>
        <createTable tableName="b2b_settlements">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="from_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="to_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="token_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(128)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(500)"/>
            <column name="requested_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_b2b_settlements_from_user" tableName="b2b_settlements">
            <column name="from_user_id"/>
        </createIndex>
        <createIndex indexName="idx_b2b_settlements_to_user" tableName="b2b_settlements">
            <column name="to_user_id"/>
        </createIndex>
        <createIndex indexName="idx_b2b_settlements_status" tableName="b2b_settlements">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_b2b_settlements_created_at" tableName="b2b_settlements">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
