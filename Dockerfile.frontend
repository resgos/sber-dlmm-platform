# ─── Stage 1: Build React Admin UI ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY dlmm-admin-ui/package.json dlmm-admin-ui/package-lock.json* ./

RUN npm ci --prefer-offline

COPY dlmm-admin-ui/ ./

RUN npm run build

# ─── Stage 2: Serve with nginx ────────────────────────────────────────────────
FROM nginx:1.25-alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Use the maintained admin nginx config (it carries the /actuator proxy, the
# immutable asset caching, and the no-cache index.html) — the live container
# already runs this one (hot-patched); docker/admin-ui-nginx.conf had diverged
# (no /actuator, no /assets) and is retired to avoid a rebuild regression.
COPY dlmm-admin-ui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
