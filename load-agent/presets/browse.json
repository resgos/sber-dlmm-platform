{
  "_comment": "ПРЕСЕТ browse — read-heavy смесь: VU случайно дёргает запросы по weight. poolId/tokenId тянутся с сервера в setup через vars.setupPath. maxRps 8: на демо-gateway rate limit ~10rps/ключ (уберите maxRps, чтобы найти предел). Только чтение.",
  "name": "browse",
  "baseUrl": "${TARGET_URL:-http://localhost:8080}",
  "timeoutMs": 10000,
  "auth": {
    "type": "login",
    "login": { "path": "/api/v1/auth/login", "method": "POST", "body": { "email": "ivanov@example.com", "password": "${LOADGEN_PW:-Demo1234}" }, "tokenField": "accessToken" }
  },
  "vars": {
    "poolId": { "setupPath": "/api/v1/pools?page=0&size=20", "extract": "content[*].id" },
    "tokenId": { "setupPath": "/api/v1/tokens?page=0&size=20", "extract": "content[*].id" },
    "page": [0, 1, 2]
  },
  "requests": [
    { "name": "pools list", "method": "GET", "path": "/api/v1/pools?page={{page}}&size=20", "weight": 5, "checks": { "status": [200], "jsonPath": "content[*].id" } },
    { "name": "pool detail", "method": "GET", "path": "/api/v1/pools/{{poolId}}", "weight": 4, "checks": { "status": [200] } },
    { "name": "pool bins", "method": "GET", "path": "/api/v1/pools/{{poolId}}/bins?from=8388558&to=8388658", "weight": 3, "checks": { "status": [200] } },
    { "name": "tokens list", "method": "GET", "path": "/api/v1/tokens?page=0&size=20", "weight": 2, "checks": { "status": [200] } },
    { "name": "token detail", "method": "GET", "path": "/api/v1/tokens/{{tokenId}}", "weight": 2 }
  ],
  "load": { "vus": 10, "durationSec": 60, "rampUpSec": 5, "thinkTimeMs": [50, 200], "maxRps": 8 },
  "thresholds": { "p95Ms": 500, "errorRatePct": 1 },
  "allowWrites": false
}
