<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sber.dlmm</groupId>
        <artifactId>sber-dlmm-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>dlmm-common</artifactId>
    <name>DLMM Common</name>

    <dependencies>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- Shared JWT auth (filter + token provider + auto-config). Optional so
             that gateway (which uses spring-cloud-gateway, not servlet stack)
             does NOT pull in spring-security-web at runtime. Each downstream
             service depends on spring-boot-starter-security on its own. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- WebFlux for the BearerTokenForwardingFilter. Optional — services
             that don't make WebClient calls won't pull it in. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!--
          Prometheus metrics scraper. Added at dlmm-common so every
          service that depends on this library + spring-boot-starter-actuator
          auto-exposes /actuator/prometheus without further wiring.
          Runtime scope: only on the classpath at run-time, doesn't leak
          into compile-time imports.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Sprint 3 #3.9: shared transactional-outbox lib lives here.
          Each dep optional so that gateway + price-oracle (no JPA / no
          outbox use) don't pay the cost. Services that ship outbox
          events add their own spring-boot-starter-data-jpa + spring-kafka
          + jackson — these poms already do, so the optional deps activate
          via the consumer's classpath.
        -->
        <!--
          Sprint 8 AU-3: JWT revocation denylist via Redis. Optional so
          gateway + price-oracle (no Redis usage) don't pay the cost.
          Consumers with spring-boot-starter-data-redis on their own
          classpath get RedisJwtRevocationService auto-registered;
          others fall back to NoopJwtRevocationService.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Sprint 9-DS-r4 (P2-13) — admin audit aspect. spring-boot-
          starter-aop is optional (services without admin mutations
          don't activate DlmmAdminAuditAutoConfiguration anyway via
          its @ConditionalOnProperty gate). But aspectjweaver is
          compile-scope here so the @Aspect annotation on
          AdminAuditAspect compiles cleanly; it's a small jar (~2MB)
          and its runtime cost is zero if the auto-config doesn't
          register the aspect bean.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          TD-2: Spring Cloud Vault opt-in skeleton. Both deps are
          OPTIONAL so a service only pulls them in when its operator
          explicitly enables Vault (SPRING_PROFILES_ACTIVE=prod,vault +
          DLMM_VAULT_ENABLED=true). Until then no Vault client is on the
          classpath and the auto-config in application-vault.yml never
          activates. Version comes from spring-cloud-dependencies BOM
          imported in the parent pom (spring-cloud.version=2023.0.1).

          Once a service decides to use Vault, the operator promotes
          these to non-optional in that service's own pom (or adds
          spring-cloud-starter-vault-config explicitly there).
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-vault-config</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-vault-config</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
