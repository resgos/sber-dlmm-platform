{
  "name": "dlmm-user-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:colors": "node ../scripts/check-no-hex-in-tsx.mjs",
    "lint:styles": "node ../scripts/check-inline-styles.mjs",
    "lint:i18n": "node ../scripts/check-no-cyrillic-in-tsx.mjs",
    "lint:api": "node ../scripts/check-api-params.mjs",
    "lint:all": "npm run lint:colors && npm run lint:styles && npm run lint:i18n && npm run lint:i18n-dead && npm run lint:dates && npm run lint:api",
    "lint:i18n-dead": "node ../scripts/check-unused-i18n-keys.mjs",
    "lint:dates": "node ../scripts/check-date-bounds.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@ant-design/pro-components": "^2.7.10",
    "@ant-design/pro-layout": "^7.19.6",
    "@tanstack/react-query": "^5.45.1",
    "antd": "^5.18.3",
    "axios": "^1.7.2",
    "dayjs": "^1.11.11",
    "i18next": "^23.7.16",
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.3",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.1"
  }
}
