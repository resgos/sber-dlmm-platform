# ============================================================================
# Sber DLMM Platform - Environment Variables
# ----------------------------------------------------------------------------
# Copy to `.env` and override values for your environment.
#   cp docker/.env.example docker/.env
# `.env` is git-ignored. Never commit production secrets to the repo.
# Spring services in this stack now FAIL FAST if these are unset (no defaults
# in application.yml), so every value below is mandatory.
# ============================================================================

# ─── Database ───────────────────────────────────────────────────────────────
# Used by all Spring services AND by the postgres container itself.
DB_USER=dlmm
DB_PASSWORD=dlmm_secret_dev_only

# ─── JWT signing key ────────────────────────────────────────────────────────
# Must be ≥ 32 bytes (256 bits). Generate a fresh one for production:
#   openssl rand -base64 48
JWT_SECRET=super-secret-jwt-key-for-dlmm-platform-256-bit-min-dev-only

# ─── Redis ──────────────────────────────────────────────────────────────────
# (No password in dev compose; set REDIS_PASSWORD if you front it with one.)

# ─── Monitoring (Grafana) ───────────────────────────────────────────────────
# Grafana admin login is `admin` / this value (compose defaults to `admin`).
GRAFANA_ADMIN_PASSWORD=admin
