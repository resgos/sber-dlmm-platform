# ============================================================================
# Sber DLMM Platform — WAL-G backup configuration (TD-6)
# ----------------------------------------------------------------------------
# Copy to `.env.walg` and override values for your environment:
#   cp docker/.env.walg.example docker/.env.walg
#
# `.env.walg` is git-ignored. Never commit production credentials.
#
# Loaded by:
#   - docker/scripts/walg-backup.sh   (cron / on-demand base backups)
#   - docker/scripts/walg-restore.sh  (DR restore)
#   - docker/docker-compose.walg.yml  (WAL-G sidecar container)
#
# See:
#   docs/OPS-DB-BACKUP-RUNBOOK.md
#   docs/runbooks/walg-disaster-recovery.md
# ============================================================================

# ─── S3 destination ─────────────────────────────────────────────────────────
# REQUIRED. The bucket+prefix where wal-g writes base backups and WAL files.
# Production example (Sber Cloud Object Storage):
#   WALG_S3_PREFIX=s3://sber-dlmm-prod-backups/cluster1
WALG_S3_PREFIX=s3://sber-dlmm-prod-backups/

# ─── S3 credentials ─────────────────────────────────────────────────────────
# REQUIRED. Generate a dedicated service account on the bucket with the
# minimal permissions:
#   s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket
# Do NOT reuse the platform application credentials.
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE

# ─── S3 endpoint + region ───────────────────────────────────────────────────
# REQUIRED. S3-compatible endpoint URL. Production Sber Cloud example:
#   AWS_ENDPOINT=https://hb.bizmrg.com
#   AWS_ENDPOINT=https://storage.yandexcloud.net   (Yandex Cloud)
#   AWS_ENDPOINT=https://s3.amazonaws.com          (AWS-native; rarely used in RU)
AWS_ENDPOINT=https://hb.bizmrg.com

# Optional. Default: ru-central1 (suits most S3-compatible RU providers).
AWS_REGION=ru-central1

# ─── Compression ────────────────────────────────────────────────────────────
# Optional. lz4 (default) is the sweet spot — ~3× faster than zstd, ~1.4×
# larger files. Options: lz4 | lzma | zstd | brotli.
# WALG_COMPRESSION_METHOD=lz4

# ─── Postgres target (rarely overridden) ────────────────────────────────────
# Container name + data directory inside the container. Defaults match
# docker-compose.yml. Override only if you renamed the service or changed
# Postgres' PGDATA.
# WALG_BACKUP_CONTAINER=dlmm-postgres
# WALG_BACKUP_USER=dlmm
# WALG_BACKUP_DB=dlmm
# WALG_PGDATA=/var/lib/postgresql/data

# ─── wal-g binary location (rarely overridden) ──────────────────────────────
# Path / name of the wal-g binary inside the postgres or sidecar container.
# Default: wal-g (must be on PATH).
# WALG_BIN=wal-g

# ─── Restore-only overrides (walg-restore.sh) ───────────────────────────────
# When restoring against a non-default container (e.g. a fresh standby for
# point-in-time recovery), point this at the new container's name.
# WALG_RESTORE_CONTAINER=dlmm-postgres-restore

# ─── Meta: env file location ────────────────────────────────────────────────
# WALG_ENV_FILE controls WHERE the scripts look for this file. It is set in
# the calling shell BEFORE the scripts run, so it can't be defined in the
# file itself (chicken-and-egg). Default: docker/.env.walg next to the
# script. Override only if your env file lives elsewhere, e.g.:
#   WALG_ENV_FILE=/etc/dlmm/walg-prod.env docker/scripts/walg-backup.sh
