{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "DLMM Overview",
  "uid": "dlmm-overview",
  "tags": ["dlmm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_memory_used_bytes, service)", "refId": "A" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "HTTP request rate (per service)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "title": "HTTP p99 latency by URI (top 5)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(5, histogram_quantile(0.99, sum by (le, uri, service) (rate(http_server_requests_seconds_bucket{service=~\"$service\"}[2m]))))",
          "legendFormat": "{{service}} {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "Hikari pool: active vs idle",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{service=~\"$service\"}",
          "legendFormat": "active / {{service}}",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{service=~\"$service\"}",
          "legendFormat": "idle / {{service}}",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{service=~\"$service\"}",
          "legendFormat": "pending / {{service}}",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"}",
          "legendFormat": "{{service}} {{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "title": "Outbox dispatcher: unpublished events (proxy via DB count)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 15, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/pools/swap\", status=\"200\"}[5m]))",
          "legendFormat": "successful swaps/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "title": "Error rate (5xx) by service",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 15, "w": 18, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\", service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    }
  ]
}
