{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "DLMM Overview",
  "uid": "dlmm-overview",
  "tags": ["dlmm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(jvm_memory_used_bytes, service)", "refId": "A" },
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "title": "HTTP request rate (per service)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "title": "HTTP p99 latency by URI (top 5)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(5, histogram_quantile(0.99, sum by (le, uri, service) (rate(http_server_requests_seconds_bucket{service=~\"$service\"}[2m]))))",
          "legendFormat": "{{service}} {{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "title": "Hikari pool: active vs idle",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{service=~\"$service\"}",
          "legendFormat": "active / {{service}}",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{service=~\"$service\"}",
          "legendFormat": "idle / {{service}}",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{service=~\"$service\"}",
          "legendFormat": "pending / {{service}}",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{service=~\"$service\", area=\"heap\"}",
          "legendFormat": "{{service}} {{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "title": "Outbox dispatcher: unpublished events (proxy via DB count)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 15, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/pools/swap\", status=\"200\"}[5m]))",
          "legendFormat": "successful swaps/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "title": "Error rate (5xx) by service",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 15, "w": 18, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\", service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "title": "Gateway throttle rate by tier (P1-14)",
      "type": "timeseries",
      "description": "Requests rejected with 429 by the per-tier rate limiter, broken out by tier (FREE / PRO / ENTERPRISE). Sustained non-zero on PRO or ENTERPRISE means we should bump the replenish rate; FREE throttles are expected and signal upsell opportunity.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tier) (rate(dlmm_gateway_ratelimit_total{outcome=\"throttled\"}[1m]))",
          "legendFormat": "{{tier}} throttled",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "title": "Gateway throttle ratio by tier (P1-14)",
      "type": "timeseries",
      "description": "Fraction of requests rejected per tier = throttled / (allowed + throttled). A tier sitting near 1.0 is fully saturated; near 0 means quota headroom.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tier) (rate(dlmm_gateway_ratelimit_total{outcome=\"throttled\"}[5m])) / clamp_min(sum by (tier) (rate(dlmm_gateway_ratelimit_total[5m])), 0.001)",
          "legendFormat": "{{tier}} throttle ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "title": "TVL rollup drift by pool (P1-12)",
      "type": "timeseries",
      "description": "Difference between LiquidityPool.totalTvlX/Y (cached, incrementally maintained) and SUM(pool_bins.reserve_x/y) (ground truth). Updated by TvlReconciliationService nightly at 03:34. Non-zero = code-path bug somewhere in swap/add/remove that's leaking the incremental updates.",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "dlmm_pool_tvl_drift",
          "legendFormat": "{{pool}} ({{side}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
