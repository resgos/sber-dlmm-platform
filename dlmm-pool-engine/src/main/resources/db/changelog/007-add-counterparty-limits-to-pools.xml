<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
      Sprint 4 #4.2 — counterparty single-swap exposure limits.

      Per-pool cap on amount_in for a single swap. NULL = no limit
      (default for existing pools — backwards compatible). Admin sets
      values per pool depending on liquidity depth + risk appetite:
      e.g. FX hedge SRUB/SCNY pool caps at 50M SRUB (max_single_swap_y
      where Y is SRUB).

      Open-position aggregation (sum across multiple swaps per user)
      is deliberately NOT in this changeset — it requires tracking
      cumulative net exposure per (user, pool), which is Sprint 5+
      work. Single-swap cap is the meaningful 80% of the protection
      for the MVP.

      Sprint 9-DS-r4 (CI fix) — preConditions added. init-db.sql for
      fresh deploys now ships these columns; on first Liquibase run
      against a freshly-initialised DB the plain addColumn would trip
      "column already exists". MARK_RAN skips cleanly.
    -->
    <changeSet id="007-add-counterparty-limits-to-pools" author="dlmm-platform">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="liquidity_pools" columnName="max_single_swap_nominal_x"/></not>
        </preConditions>
        <addColumn tableName="liquidity_pools">
            <column name="max_single_swap_nominal_x" type="BIGINT">
                <!-- NULL = no cap on X-token swaps -->
            </column>
            <column name="max_single_swap_nominal_y" type="BIGINT">
                <!-- NULL = no cap on Y-token swaps -->
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
