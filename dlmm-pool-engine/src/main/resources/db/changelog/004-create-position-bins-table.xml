<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="004-create-position-bins-table" author="dlmm-platform">
        <createTable tableName="position_bins">
            <column name="position_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_position_bins"/>
            </column>
            <column name="bin_id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_position_bins"/>
            </column>
            <column name="liquidity_shares" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_position_bins_position_id" tableName="position_bins">
            <column name="position_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
