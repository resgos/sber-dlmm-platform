<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- Sprint 17 — LP-farming rewards (reward token = Spasibo / SSPAS).
         Two tables: one row per pool configures the daily SSPAS emission;
         one row per LP position accrues the position's share of that emission
         while it is in-range, claimable to the user's SSPAS balance. -->

    <changeSet id="013-create-pool-rewards-config-table" author="dlmm-platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="pool_rewards_config"/></not>
        </preConditions>
        <createTable tableName="pool_rewards_config">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pool_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_pool_rewards_config_pool_id"/>
            </column>
            <column name="reward_token_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="emission_per_day" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="013-create-pool-position-rewards-table" author="dlmm-platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="pool_position_rewards"/></not>
        </preConditions>
        <createTable tableName="pool_position_rewards">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="pool_id" type="UUID"/>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="reward_token_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="unclaimed_reward" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="claimed_reward" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_accrual_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- One reward row per position (the accrual UPSERT key). -->
        <addUniqueConstraint constraintName="uq_pool_position_rewards_position_id"
                             tableName="pool_position_rewards"
                             columnNames="position_id"/>

        <createIndex indexName="idx_pool_position_rewards_user_id" tableName="pool_position_rewards">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_pool_position_rewards_position_id" tableName="pool_position_rewards">
            <column name="position_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
