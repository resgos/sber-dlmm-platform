<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
      Sprint 4 #4.7 — optimistic locking on liquidity_pools.
      Option A from docs/ANALYSIS-SAME-POOL-LOCK.md: add @Version column
      so concurrent swaps on the same pool detect conflicts at commit
      time rather than serialising on a Postgres row lock.

      Default 0 for existing rows so the first @Version-aware UPDATE
      doesn't fail on `version = NULL`.

      Sprint 9-DS-r4 (CI fix) — preConditions added. init-db.sql for
      fresh deploys now ships the `version` column (so 04-spasibo-seed.sql
      INSERT works); on first-Liquibase-run after that, the addColumn
      below tripped a "column already exists" error and rolled back.
      MARK_RAN skips cleanly when the column is already there.
    -->
    <changeSet id="006-add-version-to-liquidity-pools" author="dlmm-platform">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="liquidity_pools" columnName="version"/></not>
        </preConditions>
        <addColumn tableName="liquidity_pools">
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
