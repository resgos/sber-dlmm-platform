<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001-create-fee-accruals-table" author="dlmm-platform">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="fee_accruals"/></not>
        </preConditions>
        <createTable tableName="fee_accruals">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="pool_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="token_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tx_id" type="UUID"/>
            <column name="claimed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="accrued_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="claimed_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_fee_accruals_user_id" tableName="fee_accruals">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_fee_accruals_position_id" tableName="fee_accruals">
            <column name="position_id"/>
        </createIndex>

        <createIndex indexName="idx_fee_accruals_pool_id" tableName="fee_accruals">
            <column name="pool_id"/>
        </createIndex>

        <createIndex indexName="idx_fee_accruals_claimed" tableName="fee_accruals">
            <column name="claimed"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
